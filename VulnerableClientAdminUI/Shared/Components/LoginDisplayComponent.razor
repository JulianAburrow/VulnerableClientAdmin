<AuthorizeView>
    <Authorized Context="authContext">
        @if (authUser is not null)
        {
            <ul class="navbar-nav flex-row">
                <li class="nav-item mx-2">
                    <MudText Typo="Typo.subtitle1">
                        Logged in as @authUser.Identity?.Name
                    </MudText>
                </li>
            </ul>
        }
    </Authorized>
</AuthorizeView>